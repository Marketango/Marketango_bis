# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=bi_platform
POSTGRES_USER=bi_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_TTL=14400

# ─── Backend Security ─────────────────────────────────────────────────────────
# JWT signing key — generate with: openssl rand -hex 64
SECRET_KEY=CHANGE_ME_64_CHAR_HEX_STRING
# AES-256 key — must be exactly 32 bytes = 64 hex chars
# Generate with: openssl rand -hex 32
AES_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
DEBUG=false

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://marketango.co/api/v1/auth/google/callback

# ─── Meta OAuth ───────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://marketango.co/api/v1/auth/meta/callback

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ─── PDF Service ──────────────────────────────────────────────────────────────
PDF_SERVICE_URL=http://pdf-service:3001

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://marketango.co

# ─── Next.js Public ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://marketango.co/api/v1
