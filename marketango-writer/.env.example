# MUST match the JWT_SECRET of marketango-core exactly
JWT_SECRET=same_secret_as_core_min_32_chars

API_PORT=4000
NODE_ENV=production

# Agency domains allowed to make cross-origin requests
CORS_ORIGINS=https://writer.marketango.co,https://app.marketango.co,https://hosting.marketango.co,https://api.marketango.co
