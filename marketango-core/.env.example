DB_HOST=localhost
DB_PORT=3306
DB_USER=marketango
DB_PASSWORD=your_secure_password_here
DB_NAME=marketango_core

JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

API_PORT=3000
NODE_ENV=production

# Comma-separated list of allowed browser origins (CORS)
# Incluye los dominios de todos los servicios del ecosistema
CORS_ORIGINS=https://writer.agencia.com,https://hosting.agencia.com,https://ads.agencia.com,https://api.agencia.com
